# Usa la MISMA base de datos que tu ERP (ERP-RH), para que lo que se
# registre aquí aparezca directamente allá.

database_url = "postgresql://usuario:clave@host/dbname?sslmode=require"

# Opcional: si quieres pedir usuario/contraseña para entrar a esta app.
# Si quitas esta sección por completo, la app queda abierta sin login
# (útil si la vas a dejar en una tablet/computador compartido del negocio).
[usuarios]
horario = "cambia-esta-clave"
